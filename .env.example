# Strategy Finder local environment.
# Copy to .env for local use. Do not commit real secrets.
#
# Live Trade uses a local executor process. Browser code sends only non-secret
# order intent; the executor reads wallet secrets from this server-side env.

# Path to the one-shot executor built from:
# C:\Users\user\Documents\Repo2\Polymarket-crypto-5min-arbitrage-bot
EXECUTION_LAB_LIVE_EXECUTOR_PATH=C:\Users\user\Documents\Repo2\Polymarket-crypto-5min-arbitrage-bot\target\debug\live_trade_once.exe

# Optional JSON array of extra CLI args for the executor.
# Keep empty for stdin JSON. Example: ["--dry-run"] if running it manually.
EXECUTION_LAB_LIVE_EXECUTOR_ARGS_JSON=[]

# Keep 0 for dry-run. Set to 1 only when dry-run preflight is correct and you
# intend to allow real live entry orders.
EXECUTION_LAB_LIVE_ENABLED=0

# Local UI/endpoint cap. The executor also enforces MAX_ORDER_SIZE_USDC below.
EXECUTION_LAB_LIVE_MAX_STAKE_USD=5

# fixed = reject small stakes with below_exchange_min.
# exchange_min = auto-size entries to the minimum valid Polymarket order, capped
# by EXECUTION_LAB_LIVE_MAX_STAKE_USD and MAX_ORDER_SIZE_USDC.
EXECUTION_LAB_LIVE_SIZING_MODE=exchange_min

# Live exits sell the filled token with a floor below the paper exit price.
# 5 means an exit at 0.54 will sell only if best bid is >= 0.49.
EXECUTION_LAB_LIVE_EXIT_MAX_SLIPPAGE_CENTS=5

EXECUTION_LAB_LIVE_TIMEOUT_MS=8000
EXECUTION_LAB_LIVE_STDOUT_LIMIT_BYTES=65536
EXECUTION_LAB_LIVE_STDERR_LIMIT_BYTES=65536

# Optional status display hint only. The executor performs the real geoblock
# check before signing.
EXECUTION_LAB_LIVE_GEOBLOCK_ALLOWED=

# Keep live submission disabled in vite preview unless explicitly testing it.
EXECUTION_LAB_ALLOW_LIVE_TRADE_PREVIEW=0

# Executor wallet/auth config. Do not prefix these with VITE_.
# Private key is expected as hex without 0x by the side repo config.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_PROXY_ADDRESS=
CLOB_SIGNATURE_TYPE=auto

# Executor safety config. FAK/FOK only for Execution Lab live entries.
ARBITRAGE_ORDER_TYPE=FAK
MAX_ORDER_SIZE_USD=5
DRY_RUN=true
LIVE_TRADE_ONCE_LIVE_ENABLED=0
LIVE_TRADE_ONCE_LEDGER_PATH=logs/live-trade-once-ledger.jsonl

# --- Cloudflare Worker local candle proxy ----------------------------------
# The deployed Signal Committee worker cannot reach Binance from Cloudflare
# egress (403). These vars let run_playground.bat start a cloudflared tunnel
# exposing this dev server so the worker can fetch candles from your SQLite
# cache via /api/sqlite/load-ohlcv. Both are OPTIONAL; leave blank to skip.
#
# One-time setup (outside this bat):
#   winget install cloudflare.cloudflared
#   cloudflared tunnel login
#   cloudflared tunnel create <TUNNEL_NAME>
#   cloudflared tunnel route dns <TUNNEL_NAME> <hostname.yourdomain>
# Then in wrangler.toml: LOCAL_CANDLE_PROXY_URL = "https://<hostname.yourdomain>"
# And share the proxy token with the worker:
#   wrangler secret put LOCAL_CANDLE_PROXY_TOKEN   # paste LOCAL_PROXY_TOKEN value
#   npx wrangler deploy

# The named tunnel created via `cloudflared tunnel create`. run_playground.bat
# runs `cloudflared tunnel run <TUNNEL_NAME>` in a new window when set.
TUNNEL_NAME=

# Shared Bearer secret. When set, cross-origin requests to /api/sqlite/*
# (i.e. via the tunnel from the worker) must send this as
# `Authorization: Bearer <LOCAL_PROXY_TOKEN>`. Same-origin browser calls from
# the dev server itself are unaffected. Must match the worker's
# LOCAL_CANDLE_PROXY_TOKEN secret exactly.
LOCAL_PROXY_TOKEN=
