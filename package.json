    "test:json": "esno scripts/run-tests.ts --json",
    "test:e2e": "esno tests/e2e.spec.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "verify": "npm run typecheck && npm run typecheck:tests && npm run test",
    "ci": "npm run verify && npm run build:check",
    "genetic:hunt": "esno scripts/genetic-hunt.ts",
    "market:load": "esno scripts/universal-market-loader.ts",
    "alpha:sweep": "esno scripts/alpha-sweep.ts",
    "verify:alpha": "esno scripts/verify-alpha.ts",
    "hunt:massive": "esno scripts/massive-alpha-sweep.ts",
    "hunt:walk-forward": "esno scripts/walk-forward-hunt.ts",
    "hunt:quality": "esno scripts/quality-hunt.ts",
    "signal:tower": "esno scripts/signal-tower.ts",
    "signal:export": "esno scripts/export-latest-entry-signal.ts",
    "signal:export:ensemble": "esno scripts/export-latest-ensemble-entry-signal.ts",
    "paper:trade": "esno scripts/paper-trader.ts",
    "poly:integrity": "esno scripts/polymarket-universe-integrity.ts",
    "poly:sync-outcomes": "esno scripts/polymarket-sync-outcomes.ts",
    "poly:sync-outcomes:all": "esno scripts/polymarket-sync-outcomes.ts --all",
    "poly:sync-outcomes:repair": "esno scripts/polymarket-sync-outcomes.ts --refresh-recent 10000",
    "poly:sync-outcomes:repair:all": "esno scripts/polymarket-sync-outcomes.ts --all --refresh-recent 10000",
    "mine:1s": "esno scripts/second-market-miner.ts",
    "mine:1s:backfill": "esno scripts/second-market-miner.ts --mode backfill --binance-dns adguard-doh",
    "mine:1s:live": "esno scripts/second-market-miner.ts --mode live --binance-dns adguard-doh",
    "mine:1s:verify": "esno scripts/second-market-miner.ts --mode verify",
    "alpha:surgical": "esno scripts/surgical-optimization.ts",
    "validate:spread-quality": "esno scripts/validate-spread-quality.ts",
    "synthetic:pair": "esno scripts/build-synthetic-pair.ts",
    "ibkr:aggregate": "esno scripts/ibkr-aggregate-csv.ts",
    "strategies:sync-manifest": "esno scripts/sync-strategy-manifest.ts",
    "strategies:audit-prepared": "esno scripts/audit-prepared-strategies.ts",
    "build:types": "tsc -p tsconfig.types.json",
    "build:check": "vite build && esno scripts/check-bundle-budget.ts",
    "dev": "vite",
    "build": "vite build"
  },
  "devDependencies": {
    "@types/chai": "^5.2.1",
    "@types/node": "^25.0.9",
    "chai": "^5.2.0",
    "esno": "^4.8.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "lightweight-charts": "^5.1.0"
  }
}
